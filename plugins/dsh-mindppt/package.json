{
  "name": "dsh-mindppt-dsh",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "development": "./src/client/index.tsx",
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "dsh-mindppt-camera": "workspace:*",
    "dsh-mindppt-canvas-excalidraw": "workspace:*",
    "dsh-mindppt-code-editor": "workspace:*",
    "dsh-mindppt-code-parser": "workspace:*",
    "dsh-mindppt-latex": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "4.0.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib"
  ]
}
